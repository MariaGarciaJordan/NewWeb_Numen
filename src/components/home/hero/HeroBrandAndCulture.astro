---
import { Picture } from "astro:assets";
import heroImage from "@/assets/hero-culture.webp";
---
<section class="w-full bg-neutral-950 text-white">
  <!-- Text -->
  <div
    class="min-h-[70vh] flex flex-col items-center justify-center px-4 sm:px-6 lg:px-12 text-center"
  >
    <h2
      class="mb-6 text-3xl sm:text-4xl lg:text-6xl font-bold tracking-tight max-w-5xl"
    >
      Leveling up organizations to build better relationships
    </h2>

    <p class="mb-10 text-lg sm:text-xl lg:text-2xl italic">
      Building games to make world better
    </p>

    <a
      href="/contact"
      class="inline-block px-8 py-3 rounded-lg bg-white text-black text-lg lg:text-2xl font-semibold transition-transform hover:scale-105 hover:bg-purple-100"
    >
      Contact us
    </a>
  </div>

  <!-- Image -->
  <div class="w-full px-4 sm:px-0 pb-24">
    <Picture
      src={heroImage}
      alt="Brand and culture"
      class="w-full h-auto object-cover"
    />
  </div>
</section>
