---
---
<section class="w-full bg-white py-20">
  <div class="mx-auto max-w-6xl px-6 text-center">
    <h3 class="mb-4 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
      Pillars
    </h3>

    <p class="mx-auto mt-2 max-w-3xl text-base font-medium text-slate-600 sm:text-lg md:text-xl lg:text-2xl">
      This is what we consider in every decision
    </p>

    <div class="mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      <!-- Craft -->
      <div class="transition-transform duration-300 hover:scale-[1.02]">
        <div class="flex flex-col items-center p-6 text-center">
          <svg
            class="mb-6 h-16 w-16 sm:h-20 sm:w-20 lg:h-24 lg:w-24 text-neutral-900"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path d="M4 20h16" />
            <path d="M8 20V8l4-4 4 4v12" />
          </svg>

          <h4 class="mb-2 text-xl font-semibold sm:text-2xl">
            Craft
          </h4>
          <h5 class="text-base text-slate-600 sm:text-lg">
            Art as a driver
          </h5>
        </div>
      </div>

      <!-- Learn -->
      <div class="transition-transform duration-300 hover:scale-[1.02]">
        <div class="flex flex-col items-center p-6 text-center">
          <svg
            class="mb-6 h-16 w-16 sm:h-20 sm:w-20 lg:h-24 lg:w-24 text-neutral-900"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <circle cx="12" cy="12" r="9" />
            <path d="M8 12h8" />
          </svg>

          <h4 class="mb-2 text-xl font-semibold sm:text-2xl">
            Learn
          </h4>
          <h5 class="text-base text-slate-600 sm:text-lg">
            Humans play to learn.
          </h5>
        </div>
      </div>

      <!-- Remix -->
      <div class="transition-transform duration-300 hover:scale-[1.02]">
        <div class="flex flex-col items-center p-6 text-center">
          <svg
            class="mb-6 h-16 w-16 sm:h-20 sm:w-20 lg:h-24 lg:w-24 text-neutral-900"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path d="M4 4h16v16H4z" />
            <path d="M8 8h8v8H8z" />
          </svg>

          <h4 class="mb-2 text-xl font-semibold sm:text-2xl">
            Remix
          </h4>
          <h5 class="text-base text-slate-600 sm:text-lg">
            Feel free to copy it and make it better.
          </h5>
        </div>
      </div>
    </div>
  </div>
</section>
