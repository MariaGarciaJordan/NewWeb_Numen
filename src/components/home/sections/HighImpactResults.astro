---
---
<section class="w-full bg-white py-20">
  <div class="mx-auto max-w-6xl px-6 text-center">
    <h3 class="mb-8 text-3xl font-bold tracking-tight md:text-4xl lg:text-5xl">
      High-Impact Gamified Results
    </h3>

    <p class="mx-auto max-w-4xl text-lg text-neutral-600 md:text-xl lg:text-2xl md:pt-12">
      Immersive environments engage employees with 3D experiences, offering
      curriculum vitae, organizational history, and cultural immersion journeys
    </p>

    <div class="mt-16 grid gap-12 lg:grid-cols-3">
      <!-- Curriculum Vitae -->
      <div class="flex flex-col items-center text-center p-6">
        <svg
          class="mb-6 h-16 w-16 sm:h-20 sm:w-20 lg:h-24 lg:w-24 text-neutral-900"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <rect x="4" y="3" width="16" height="18" rx="2" />
          <line x1="8" y1="7" x2="16" y2="7" />
          <line x1="8" y1="11" x2="16" y2="11" />
          <line x1="8" y1="15" x2="13" y2="15" />
        </svg>
        <h4 class="text-xl font-medium">
          Curriculum vitae experience
        </h4>
      </div>

      <!-- Organization History -->
      <div class="flex flex-col items-center text-center p-6">
        <svg
          class="mb-6 h-16 w-16 sm:h-20 sm:w-20 lg:h-24 lg:w-24 text-neutral-900"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <path d="M3 21h18" />
          <path d="M6 21V7l6-4 6 4v14" />
          <path d="M9 21v-6h6v6" />
        </svg>
        <h4 class="text-xl font-medium">
          Organization History
        </h4>
      </div>

      <!-- Culture Experience -->
      <div class="flex flex-col items-center text-center p-6">
        <svg
          class="mb-6 h-16 w-16 sm:h-20 sm:w-20 lg:h-24 lg:w-24 text-neutral-900"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <circle cx="12" cy="12" r="9" />
          <path d="M12 3v18" />
          <path d="M3 12h18" />
        </svg>
        <h4 class="text-xl font-medium">
          Culture Experience
        </h4>
      </div>
    </div>
  </div>
</section>
