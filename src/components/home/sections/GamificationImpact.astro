---
import BoostsProductivityImage from "@assets/boosts-productivity.jpg";
---
<section class="w-full bg-white py-20">
  <div class="mx-auto max-w-6xl px-6">
    <div class="grid items-center gap-12 lg:grid-cols-2">
      <div class="flex flex-col justify-center">
        <h3 class="mb-6 text-center text-3xl font-bold tracking-tight lg:mb-8 lg:text-5xl lg:text-left">
          Gamification increases employee productivity by up to 90%
        </h3>

        <p class="mb-6 text-lg text-slate-600">
          Training simulations provide a cutting-edge way to develop employee skills
          and unlock their highest potential. Are you ready to elevate your training
          programs through the power of gamification?
        </p>

        <div class="mt-6 mb-8 flex justify-center lg:justify-start">
          <a
            href="/contact"
            target="_blank"
            rel="noopener"
            class="inline-block rounded-lg bg-neutral-900 px-6 py-3 text-lg font-medium text-white transition hover:bg-neutral-800"
          >
            Talk to us
          </a>
        </div>
      </div>

      <div>
        <img
          src={BoostsProductivityImage.src}
          alt="self paced training illustration"
          class="w-full max-w-full"
          loading="lazy"
        />
      </div>
    </div>
  </div>
</section>
