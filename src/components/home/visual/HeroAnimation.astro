---
import ArchImage from "@assets/union.svg";
---
<section class="sectionHero">
  <div class="container px-10 xl:px-0">
    <div class="tunnel">
      {Array.from({ length: 10 }).map((_, i) => (
        <img
          src={ArchImage.src}
          alt={`Arch layer ${i + 1}`}
          class="arch"
        />
      ))}
    </div>
  </div>
</section>

<style>
.sectionHero {
  background-color: #212123;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100dvh;
  width: 100%;
  margin: 0;
  padding-top: 250px;
  overflow: hidden;
}

.tunnel {
  position: relative;
  width: 100%;
  height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  max-width: 460px;
  margin: 0 auto;
}

.arch {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 280px;
  height: auto;
  animation: tunnelAnimation 27s linear infinite;
  animation-fill-mode: both;
  transform: translate(-50%, -50%) scale(0.8);
  opacity: 0;
}

@media screen and (min-width: 1920px) {
  .tunnel {
    max-width: 800px;
  }
  .arch {
    width: 400px;
  }
}

@media screen and (min-width: 1535px) {
  .tunnel {
    max-width: 800px;
  }
  .arch {
    width: 320px;
  }
}

@media screen and (max-width: 1280px) {
  .arch {
    width: 60%;
  }
}

.arch:nth-child(1) { animation-delay: -27s; }
.arch:nth-child(2) { animation-delay: -24s; }
.arch:nth-child(3) { animation-delay: -21s; }
.arch:nth-child(4) { animation-delay: -18s; }
.arch:nth-child(5) { animation-delay: -15s; }
.arch:nth-child(6) { animation-delay: -12s; }
.arch:nth-child(7) { animation-delay: -9s; }
.arch:nth-child(8) { animation-delay: -6s; }
.arch:nth-child(9) { animation-delay: -3s; }
.arch:nth-child(10) { animation-delay: 0s; }

@keyframes tunnelAnimation {
  0% {
    transform: translate(-50%, -50%) scale(0.5);
    opacity: 0;
  }
  50% {
    transform: translate(-50%, -50%) scale(2);
    opacity: 0.2;
  }
  70% {
    transform: translate(-50%, -50%) scale(2.5);
    opacity: 0;
  }
  100% {
    transform: translate(-50%, -50%) scale(3);
    opacity: 0;
  }
}
</style>
