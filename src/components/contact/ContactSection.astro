---
import ContactForm from "./ContactForm.astro";
---

<section class="max-w-5xl mx-auto">
  <header class="mb-10 text-center">
    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight">
      Turn your vision into reality
    </h1>
    <p class="mt-4 text-neutral-300 text-base sm:text-lg">
      Tell us about your project and we’ll help you find the right match.
    </p>
  </header>

  <div class="grid gap-10 lg:grid-cols-2 items-start">
    <div class="rounded-2xl overflow-hidden border border-white/10 bg-white/5">
      <iframe
        src="https://app.spline.design/file/c9b86da0-7c77-4710-9e84-04d7cc6ae33c?view=preview&fullscreen=false"
        class="w-full h-[320px] lg:h-[520px]"
        loading="lazy"
        referrerpolicy="no-referrer"
        title="Spline preview"
      ></iframe>
    </div>

    <ContactForm />
  </div>
</section>
