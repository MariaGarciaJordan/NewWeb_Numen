<form
  id="contact-form"
  class="space-y-6 rounded-2xl border border-white/10 bg-white/5 p-6 sm:p-8"
  novalidate
>
  <!-- Web3Forms -->
  <input type="hidden" name="access_key" value="fca434f5-b15d-49d6-90e5-047ac677fbc4" />
  <input type="checkbox" name="botcheck" class="hidden" style="display:none" />

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <label for="firstName" class="block text-sm font-medium text-neutral-200 mb-2">
        First name
      </label>
      <input
        id="firstName"
        name="first_name"
        type="text"
        required
        placeholder="First name"
        class="w-full rounded-lg border border-white/10 bg-black/20 px-4 py-3 outline-none focus:border-white/30"
      />
    </div>

    <div>
      <label for="lastName" class="block text-sm font-medium text-neutral-200 mb-2">
        Last name
      </label>
      <input
        id="lastName"
        name="last_name"
        type="text"
        required
        placeholder="Last name"
        class="w-full rounded-lg border border-white/10 bg-black/20 px-4 py-3 outline-none focus:border-white/30"
      />
    </div>
  </div>

  <div>
    <label for="email" class="block text-sm font-medium text-neutral-200 mb-2">
      Work email
    </label>
    <input
      id="email"
      name="email"
      type="email"
      required
      placeholder="name@company.com"
      class="w-full rounded-lg border border-white/10 bg-black/20 px-4 py-3 outline-none focus:border-white/30"
    />
  </div>

  <div>
    <label for="message" class="block text-sm font-medium text-neutral-200 mb-2">
      What do you want to build?
    </label>
    <textarea
      id="message"
      name="project_description"
      required
      placeholder="Tell us more about your project..."
      class="w-full min-h-[140px] rounded-lg border border-white/10 bg-black/20 px-4 py-3 outline-none focus:border-white/30"
    ></textarea>
  </div>

  <div class="flex items-start gap-3">
    <input id="terms" name="terms" type="checkbox" required class="mt-1 h-4 w-4" />
    <label for="terms" class="text-sm text-neutral-300">
      I agree to Numen Games
      <a href="/terms" class="underline text-neutral-100 hover:text-white">
        Terms and Conditions
      </a>
    </label>
  </div>

  <button
    type="submit"
    class="w-full rounded-lg bg-white text-black font-semibold py-3 transition-transform hover:scale-[1.01]"
  >
    Submit
  </button>

  <p id="form-result" class="text-sm text-center"></p>
</form>

<script is:inline>
  const form = document.getElementById("contact-form");
  const result = document.getElementById("form-result");

  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    result.textContent = "Sending...";
    result.className = "text-sm text-center text-neutral-300";

    const formData = new FormData(form);
    const payload = Object.fromEntries(formData.entries());

    try {
      const response = await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify(payload),
      });

      const data = await response.json();

      if (response.ok) {
        result.textContent = data.message || "Sent!";
        result.className = "text-sm text-center text-green-400";
        form.reset();
      } else {
        result.textContent = data.message || "Something went wrong.";
        result.className = "text-sm text-center text-red-400";
      }
    } catch (err) {
      result.textContent = "Network error. Please try again.";
      result.className = "text-sm text-center text-red-400";
    }
  });
</script>
