---
const links = [
  { href: "/pricing", label: "Pricing" },
  { href: "/services", label: "Services" },
  { href: "/team", label: "Team" },
  { href: "/contact", label: "Contact" },
];

const pathname = Astro.url?.pathname ?? "/";
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<header class="w-full border-b border-white/10 bg-neutral-950/80 backdrop-blur supports-[backdrop-filter]:bg-neutral-950/60">
  <nav class="mx-auto max-w-6xl px-4 sm:px-6 py-3 sm:py-4 flex items-center justify-between gap-3">
    <a
      href="/"
      class="inline-flex items-center rounded-md px-2 py-1 font-semibold tracking-wide text-white hover:text-white/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/40"
    >
      <span class="text-sm sm:text-base">NUMEN</span>
    </a>

    <!-- Desktop -->
    <ul class="hidden md:flex items-center gap-2 text-sm">
      {links.map((l) => {
        const active = isActive(l.href);
        return (
          <li>
            <a
              href={l.href}
              aria-current={active ? "page" : undefined}
              class:list={[
                "inline-flex items-center rounded-full px-3 py-1.5 transition",
                "text-neutral-200 hover:text-white hover:bg-white/5",
                "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/40",
                active && "bg-white/10 text-white",
              ]}
            >
              {l.label}
            </a>
          </li>
        );
      })}
    </ul>

    <!-- Mobile (sin JS) -->
    <details class="md:hidden group">
      <summary
        class="list-none inline-flex items-center justify-center rounded-md p-2 text-neutral-200 hover:text-white hover:bg-white/5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/40 cursor-pointer"
        aria-controls="mobile-menu"
      >
        <span class="sr-only">Open menu</span>

        <!-- icon burger -->
        <svg
          class="block group-open:hidden"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>

        <!-- icon close -->
        <svg
          class="hidden group-open:block"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
        >
          <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </summary>

      <div id="mobile-menu" class="mt-3 border-t border-white/10 pt-3">
        <ul class="flex flex-col gap-1">
          {links.map((l) => {
            const active = isActive(l.href);
            return (
              <li>
                <a
                  href={l.href}
                  aria-current={active ? "page" : undefined}
                  class:list={[
                    "flex items-center justify-between rounded-lg px-3 py-2 transition",
                    "text-neutral-200 hover:text-white hover:bg-white/5",
                    "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/40",
                    active && "bg-white/10 text-white",
                  ]}
                >
                  <span>{l.label}</span>
                  {active ? <span class="text-xs text-white/70">Current</span> : null}
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </details>
  </nav>
</header>
