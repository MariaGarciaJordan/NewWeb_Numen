---
import LayoutShell from "../../components/layout/LayoutShell.astro";

const title = "Numen Games - Blog";
---

<LayoutShell title={title} description="Numen Games blog">
  <section class="px-4 lg:px-10 pt-28 lg:pt-32 pb-16">
    <div class="mx-auto max-w-6xl">
      <p class="font-IBMPlexMono text-xs tracking-[0.25em] text-primary-beige/60">[BLOG]</p>

      <h1 class="mt-4 text-4xl sm:text-5xl lg:text-6xl font-medium tracking-[-0.03em] text-primary-beige">
        Blog
      </h1>

      <p class="mt-6 text-primary-beige/70 leading-relaxed max-w-2xl">
        Coming soon.
      </p>

      <div class="mt-10 rounded-lg border border-white/10 bg-white/5 p-6">
        <p class="text-primary-beige/70">
          This section is intentionally empty for now. The structure is in place.
        </p>
      </div>
    </div>
  </section>
</LayoutShell>
