---
import BlogLayout from "./BlogLayout.astro";

const title = "Numen Games · Blog";
---

<BlogLayout title={title} description="Numen Games blog">
  <Fragment slot="header">
    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-medium tracking-[-0.03em]">
      Blog
    </h1>

    <p class="mt-6 text-primary-beige/70 leading-relaxed max-w-2xl">
      Coming soon.
    </p>
  </Fragment>

  <div class="rounded-lg border border-white/10 bg-primary-panther/20 p-6">
    <div class="flex flex-col gap-3">
      <p class="text-primary-beige/70">
        No posts yet.
      </p>
      <p class="text-sm text-primary-beige/50">
        This page is intentionally a stub. The layout is ready for future content.
      </p>
    </div>
  </div>
</BlogLayout>
