---
import LayoutShell from "@layout/LayoutShell.astro";
---

<LayoutShell title="Training · Numen Games">
  <main class="px-4 sm:px-6 lg:px-12 py-16">
    <section class="max-w-4xl mx-auto text-center">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight">
        Training
      </h1>
      <p class="mt-4 text-neutral-300 text-base sm:text-lg">
        This page is being rebuilt. We’re migrating it next.
      </p>

      <div class="mt-10 flex items-center justify-center gap-3">
        <a
          href="/contact"
          class="inline-block px-6 py-3 rounded-lg bg-white text-black font-semibold hover:scale-[1.01] transition-transform"
        >
          Contact
        </a>
        <a
          href="/"
          class="inline-block px-6 py-3 rounded-lg border border-white/15 text-white hover:bg-white/10 transition-colors"
        >
          Home
        </a>
      </div>
    </section>
  </main>
</LayoutShell>
