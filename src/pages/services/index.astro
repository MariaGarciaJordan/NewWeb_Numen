---
import LayoutShell from "@layout/LayoutShell.astro";
---

<LayoutShell title="Services — Numen Games">
  <section class="mx-auto max-w-5xl px-6 py-16 text-center">
    <h1 class="text-4xl sm:text-5xl font-bold tracking-tight">Services</h1>
    <p class="mt-4 text-neutral-300">
      This page is being rebuilt. We’re migrating it next.
    </p>

    <div class="mt-10 flex flex-col sm:flex-row gap-3 justify-center">
      <a
        href="/services/engagement"
        class="inline-block px-6 py-3 rounded-lg bg-white text-black font-semibold hover:scale-105 transition-transform"
      >
        Engagement
      </a>
      <a
        href="/services/training"
        class="inline-block px-6 py-3 rounded-lg bg-white text-black font-semibold hover:scale-105 transition-transform"
      >
        Training
      </a>
      <a
        href="/services/experience"
        class="inline-block px-6 py-3 rounded-lg bg-white text-black font-semibold hover:scale-105 transition-transform"
      >
        Experience
      </a>
    </div>
  </section>
</LayoutShell>
